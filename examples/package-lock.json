{
  "name": "uhppoted-nodejs-examples",
  "lockfileVersion": 2,
  "requires": true,
  "packages": {
    "": {
      "name": "uhppoted-nodejs-examples",
      "dependencies": {
        "uhppoted": "file:.."
      }
    },
    "..": {
      "name": "uhppoted",
      "version": "0.9.1",
      "license": "MIT",
      "dependencies": {
        "os": "^0.1.1"
      },
      "devDependencies": {
        "@eslint/js": "^10.0.1",
        "chai": "^6.2.2",
        "eslint": "^10.4.1",
        "globals": "^17.6.0",
        "jsdoc": "^4.0.5",
        "mocha": "^11.7.6",
        "prettier": "^3.8.3"
      },
      "engines": {
        "node": ">=14.18.3"
      }
    },
    "node_modules/uhppoted": {
      "resolved": "..",
      "link": true
    }
  },
  "dependencies": {
    "uhppoted": {
      "version": "file:..",
      "requires": {
        "@eslint/js": "^10.0.1",
        "chai": "^6.2.2",
        "eslint": "^10.4.1",
        "globals": "^17.6.0",
        "jsdoc": "^4.0.5",
        "mocha": "^11.7.6",
        "os": "^0.1.1",
        "prettier": "^3.8.3"
      }
    }
  }
}
